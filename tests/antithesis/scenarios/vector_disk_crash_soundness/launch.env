# Per-scenario settings for ../launch.sh. Only the bits that differ from every
# other scenario live here; the launcher supplies the rest.
SCENARIO_TEST_NAME=vector_disk_crash_soundness
SCENARIO_DESCRIPTION="disk_v2 buffer soundness (no corruption/invented ids, no internal accounting underflow, recovers to liveness) under crash/hang/throttle of the node -- conservation is deliberately NOT asserted"
SCENARIO_FAULT_NODES="vector"
